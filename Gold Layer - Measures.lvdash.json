{
  "datasets": [
    {
      "name": "3529cf37",
      "displayName": "Weekly Revenue Distribution by Day of Week Analysis",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "  d.day_name,\n",
        "  d.day_of_week,\n",
        "  ROUND(100.0 * SUM(f.total_amount) / SUM(SUM(f.total_amount)) OVER (), 2) AS pct_of_revenue\n",
        "FROM nyc_taxi.gold.fact_trips f\n",
        "JOIN nyc_taxi.gold.dim_date d ON f.date_key = d.date_key\n",
        "GROUP BY d.day_name, d.day_of_week\n",
        "ORDER BY d.day_of_week;"
      ]
    },
    {
      "name": "076aceaf",
      "displayName": "Taxi Trip Counts Grouped by Borough Pickup Locations",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT p.pickup_borough, COUNT(*) AS trips\n",
        "FROM nyc_taxi.gold.fact_trips f\n",
        "JOIN nyc_taxi.gold.dim_pickup_zone p ON f.pickup_zone_key = p.pickup_zone_key\n",
        "GROUP BY p.pickup_borough\n",
        "ORDER BY trips DESC;"
      ]
    },
    {
      "name": "cc7306bf",
      "displayName": "Monthly Insights on Complete Week Taxi Revenue",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "WITH weekly_revenue AS (\n",
        "  SELECT\n",
        "    date_trunc('week', date_key) AS week_start,\n",
        "    COUNT(DISTINCT date_key)     AS days_in_week,\n",
        "    SUM(total_amount)            AS revenue\n",
        "  FROM nyc_taxi.gold.fact_trips\n",
        "  GROUP BY date_trunc('week', date_key)\n",
        ")\n",
        "SELECT\n",
        "  date_format(week_start, 'yyyy-MM') AS month,\n",
        "  month(week_start)                  AS month_num,\n",
        "  ROUND(AVG(revenue), 2)             AS avg_weekly_revenue,\n",
        "  COUNT(*)                           AS full_weeks_in_month\n",
        "FROM weekly_revenue\n",
        "WHERE days_in_week = 7\n",
        "GROUP BY date_format(week_start, 'yyyy-MM'), month(week_start)\n",
        "ORDER BY month_num;"
      ]
    },
    {
      "name": "53080d29",
      "displayName": "Monthly Average Weekly Taxi Revenue Insights",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "WITH weekly_revenue AS (\n",
        "  SELECT\n",
        "    date_trunc('week', date_key) AS week_start,\n",
        "    COUNT(DISTINCT date_key)     AS days_in_week,\n",
        "    SUM(total_amount)            AS revenue\n",
        "  FROM nyc_taxi.gold.fact_trips\n",
        "  GROUP BY date_trunc('week', date_key)\n",
        ")\n",
        "SELECT\n",
        "  date_format(week_start, 'yyyy-MM') AS month,\n",
        "  month(week_start)                  AS month_num,\n",
        "  ROUND(AVG(revenue), 2)             AS avg_weekly_revenue,\n",
        "  COUNT(*)                           AS full_weeks_in_month\n",
        "FROM weekly_revenue\n",
        "WHERE days_in_week = 7\n",
        "GROUP BY date_format(week_start, 'yyyy-MM'), month(week_start)\n",
        "ORDER BY month_num;"
      ]
    }
  ],
