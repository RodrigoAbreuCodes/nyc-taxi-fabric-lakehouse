  "datasets": [
    {
      "name": "ab7b734c",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "  _reject_reason,\n",
        "  COUNT(*)                                                  AS rejected_rows,\n",
        "  ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2)        AS pct_of_rejects\n",
        "FROM nyc_taxi.silver.trips_quarantine\n",
        "GROUP BY _reject_reason\n",
        "ORDER BY rejected_rows DESC;\n"
      ]
    }
  ],
